{
  "name": "houselearning-app",
  "version": "1.0.0",
  "description": "Desktop app for HouseLearning",
  "author": "Ollie",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --windows --linux"
  },
  "devDependencies": {
    "electron": "30.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.houselearning.app",
    "productName": "HouseLearning",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icon.png",
      "category": "Education"
    }
  }
}
